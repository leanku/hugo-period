#!/bin/sh
# Period 主题加密 pre-commit 钩子：阻止含未加密明文标记（{{%/* protect */%}}）的文章被提交。
# 若命中，请先运行：node themes/period/scripts/encrypt.mjs --lock content/ 再提交。
# 安装：复制到 .git/hooks/pre-commit 并确保可执行。

marker='{{%/* protect */%}}'
files=$(git diff --cached --name-only --diff-filter=ACM -- 'content/*.md')

if [ -z "$files" ]; then
  exit 0
fi

blocked=""
for f in $files; do
  if grep -qF "$marker" "$f" 2>/dev/null; then
    blocked="$blocked\n  $f"
  fi
done

if [ -n "$blocked" ]; then
  echo "错误：以下文件仍包含未加密的明文标记，已阻止提交："
  echo "$blocked"
  echo
  echo "处理方式：node themes/period/scripts/encrypt.mjs --lock <文件> 后再提交。"
  echo "（如确需明文提交，请用 git commit --no-verify 跳过本次检查）"
  exit 1
fi

exit 0
